{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onyx-edge-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "onyx-edge.axim.us.com",
      "zone_name": "axim.us.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "CORE_INGEST_URL": "https://api.axim.us.com/v1/functions/telemetry-ingest"
  },
  "kv_namespaces": [
    {
      "binding": "ONYX_DISPATCH_LOCKS",
      "id": "4b72094b034d4732adbbfeaad4d33b2c"
    },
    {
      "binding": "ONYX_PROMPT_CACHE",
      "id": "186183af00e3487ba5b70d7f0b0e8cbe"
    },
    {
      "binding": "ONYX_SESSION_STATE",
      "id": "1cb8dcf7fea24988b75aa43b73777364"
    },
    {
      "binding": "ONYX_STATE",
      "id": "049c627a0e144fddaee6ec4034c1f2bd"
    }
  ],
  "d1_databases": [
    {
      "binding": "ONYX_DB",
      "database_name": "onyx-edge-bridge-db",
      "database_id": "5477ab45-92a4-4c0e-97c4-5fb2bae2f650",
      "migrations_dir": "migrations"
    }
  ]
}
